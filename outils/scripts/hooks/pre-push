#!/bin/zsh
# pre-push — lance outils/scripts/non_regression.sh AVANT tout push qui touche un contrôle commun.
#
# Installation (une fois, config locale, non versionnée) :   git config core.hooksPath outils/scripts/hooks
# Contournement assumé :                                      git push --no-verify   (ou SKIP_NR=1 git push)
#
# Deux déclencheurs. (1) Un CONTRÔLE commun modifié → non_regression.sh (≈ 90 s), push refusé si un
# verdict a changé ; si c'est controle_attributions.py ou extract_docx.py (qui le nourrit) qui est touché,
# non_regression.sh --complet (13/09/2026) : les passes avec aspiration — B (citations, ㉓ ㉔), C2, D — ne
# sont exercées que là, sur les témoins conformes qui doivent sortir en 0 (trois documents vivants + les copies
# figées de non_regression/temoins_attributions_conformes/, 20/09/2026) et les témoins d'avant correction qui
# doivent sortir en 1 (≈ 4-5 min de plus, réseau). Un exit 3 (page non lue) n'est pas une régression :
# le harnais l'affiche « à relancer » et laisse passer — relance --complet à la main.
# (2) Des DOCUMENTS (.docx de livrables/lecons ou sources/veille) ajoutés ou modifiés →
# non_regression.sh --docs sur ces seuls fichiers (quelques secondes par document) : un document ne doit
# pas régresser par rapport à sa référence, un document nouveau doit être à 0 bloquant, un décompte de
# veille ne doit pas être incohérent. C'est par là que passent les pushs des 14 jobs : un livrable
# défectueux n'est pas publié, le log du job dit pourquoi (run_job.sh retente trois fois puis abandonne).
# Règle de JOBS.md (12/09/2026), rendue exécutable.
# 🔴 27/10/2026 — git exporte GIT_DIR (et parfois GIT_WORK_TREE, GIT_INDEX_FILE, GIT_QUARANTINE_PATH)
# à ses hooks, et depuis que `.git` est un fichier d'une ligne hors de l'arbre, ce chemin est ABSOLU :
# tout `git` lancé par un enfant du hook visait alors LE VRAI DÉPÔT quel que soit son `cd`, ce qui a
# mis le dépôt en core.bare=true pendant un push. On désarme ici, une fois, pour tout ce que le hook
# lance ; le runner le refait chez lui, parce qu'il est aussi lancé à la main. ⚠️ ET CE BLOC DOIT PRÉCÉDER LE CALCUL DE $ROOT : mesuré le 27/10, placé
# après, un GIT_DIR pointant AILLEURS faisait échouer `rev-parse --show-toplevel`, donc ROOT
# vide, donc `/outils/scripts/non_regression.sh` introuvable — et le hook refusait le push
# en annonçant « un verdict a changé », un motif FAUX. Désarmé d'abord, ROOT se déduit du
# fichier `.git` de l'arbre, c'est-à-dire de la découverte normale.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR \
      GIT_QUARANTINE_PATH GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
ROOT="$(git rev-parse --show-toplevel)"
[ -n "$ROOT" ] || { echo "pre-push : ✗ racine du dépôt introuvable — git rev-parse --show-toplevel a échoué."; echo "  Rien n'a été vérifié, le push est refusé. Vérifie le fichier .git de l'arbre de travail."; exit 1; }
# (1 ter) LES DEUX SCRIPTS QUE LE HARNAIS EXÉCUTE SANS LES SURVEILLER (11/11/2026).
# Mesuré : des 27 scripts que non_regression.sh référence par chemin, DEUX n'appartenaient
# à aucune catégorie — balayer_adresses.py (ATTENDU_BAL=72, bloc « 0 septies ») et
# ca_bundle.py (ATTENDU_CA=6, bloc « 0 octies ». Leurs bornes vivent DANS le harnais, donc
# les toucher aurait dû le lancer ; il ne se lançait pas. Le garde correspondant n'est plus
# un inventaire mais un PRÉDICAT LU DANS LE HARNAIS : tout script que non_regression.sh
# exécute doit être déclenché par le hook (borne ⑫ de non_regression/categories_hook.py).
# (1 bis) LES TÉMOINS DU HARNAIS, PAR MOTIF DE RÉPERTOIRE (11/11/2026). Mesuré : NEUF des
# douze fichiers de outils/scripts/non_regression/ n'appartenaient à AUCUNE catégorie —
# bfr_journal, coherence_skill, corps_tronque, desarmement_git, etiquette_has, faisceau_5bis,
# murs_lus, publication_run, tolerance_page_morte. Un push qui ne touchait qu'eux ne
# déclenchait RIEN : le témoin pouvait être amputé ou saboté et partir sur le dépôt sans
# qu'une seule de ses bornes soit jouée. C'est le défaut du 27/10 (CLAUDE.md sans catégorie)
# et du 06/11 (rattrapage_jobs.sh), à l'échelle d'un répertoire entier.
# ⛔ UN MOTIF, PAS UNE LISTE : une liste de fichiers en dur se périme au prochain témoin
# écrit, et c'est le défaut que ce dépôt a déjà payé trois fois (setup_launchd.sh,
# rattrapage_jobs.sh, la table dossier → job de ㊳). non_regression/categories_hook.py
# garde que le motif couvre TOUS les témoins, par un prédicat structurel et non un compte.
# (1 quater) 11/11/2026 — LES SIX DERNIERS SCRIPTS DE PREMIER NIVEAU ENTRENT ICI, ET IL FAUT
#   DIRE CE QUE CELA VAUT POUR CHACUN, parce que ce n'est pas la même chose :
#     · controle_clauses_parcours.py — RÉELLEMENT EXÉCUTÉ par le harnais (témoin de
#       supprimer_job.sh, forme Python « racine + "/outils/… » que l'ancien motif ratait) :
#       les 5 scénarios l'appellent et exigent le compte qu'il lit. C'est un VRAI garde.
#     · setup_launchd.sh — n'est PAS exécuté : il figure comme ARGUMENT d'un git status.
#     · audit_vault.py — une seule mention dans le harnais, et elle est EN COMMENTAIRE.
#     · fiches_obsidian.py · fiches_veille.py · teardown_launchd.sh — ZÉRO occurrence.
#   ⚠️ Pour ces cinq-là, la catégorie est donc un DÉCLENCHEMENT, pas une couverture : le push
#   lance le harnais complet, qui ne les exécute pas. Ce que cela attrape est le dommage
#   collatéral (un .plist, une fiche, un classeur cassés par ailleurs), pas leur logique propre.
#   Le dire ainsi évite la pire erreur : lire « 0 orphelin » comme « tout est testé ».
SURVEILLES='^(jobs_config\.json|outils/scripts/(controle_attributions\.py|controle_decompte\.py|extract_docx\.py|non_regression\.sh|hooks/pre-push|controle_astrologie_karmique\.py|controle_psychopathologie\.py|controle_ai_act\.py|controle_edition_precedente\.py|non_regression/muter_docx\.py|chercher\.py|aspirer\.py|lire_page\.py|supprimer_job\.sh|refaire_classeur\.py|maj_xlsx_jobs\.py|controle_livrable_du_job\.py|controle_orthographe\.py|controle_noms_propres\.py|rattrapage_jobs\.sh|controle_integrite_livrables\.py|balayer_adresses\.py|ca_bundle\.py|audit_vault\.py|controle_clauses_parcours\.py|fiches_obsidian\.py|fiches_veille\.py|setup_launchd\.sh|teardown_launchd\.sh|non_regression/[a-z0-9_]+\.py))$'
ASPIRATION='^outils/scripts/(controle_attributions\.py|extract_docx\.py)$'
# (2 bis) LES DEUX ÉTAPES 5 BIS SORTIES DES PROMPTS LE 08/10/2026 et leur fabricant de
# mutations → non_regression.sh --complet, parce que c'est LÀ que vivent leurs témoins
# (section 5 ter : un témoin conforme en 0, une mutation en 1). Sans cette ligne, éditer
# controle_astrologie_karmique.py ou controle_psychopathologie.py déclenchait le mode
# normal — 90 s qui ne les exécutent pas — et une étape 5 bis cassée partait sur le dépôt
# sans que rien ne le dise. Vérifié au harnais le 08/10/2026 : motif ① neutralisé →
# « ✗ LE CONTRÔLE NE MORD PLUS », exit 1 ; script restauré, sha256 identique.
CINQBIS='^outils/scripts/(controle_astrologie_karmique\.py|controle_psychopathologie\.py|controle_ai_act\.py|non_regression/muter_docx\.py)$'
# 12/10/2026 — controle_edition_precedente.py relit une édition de veille à l'édition PRÉCÉDENTE et
# à la fiche de celle-ci. Ses deux témoins (rejeu en 1 AVEC sa ligne, conforme en 0) vivent en
# section 5 quater, donc en --complet : le toucher force le mode complet, sans quoi ses témoins ne
# seraient jamais joués et une retouche passerait sans preuve. Le contrôle lui-même ne coûte rien
# (0,3 s, aucun appel réseau) et tourne aussi en --docs sur chaque veille poussée.
EDPREC='^outils/scripts/(controle_edition_precedente\.py|non_regression/omission_axe2\.py|non_regression/temoins_edition_precedente/.*)$'
# (3) LE RUNNER modifié → non_regression_runner.sh --mutations (auto-tests du juge, 14 scénarios de décision, PUIS dix-huit
#     mutations du runner qui vérifient que ces témoins tombent quand on le casse exprès, ≈ 30 s,
# sans réseau). run_job.sh décide ce qui est retenté et ce qui est publié pour les 14 jobs ;
# il n'était couvert par rien. Déclencheur SÉPARÉ de SURVEILLES : toucher au runner n'oblige
# pas à rejouer les 250 documents, et toucher à un contrôle commun n'oblige pas à rejouer le
# runner. Le harnais lui-même est surveillé : le modifier le relance (27/09/2026).
RUNNER_RE='^outils/scripts/(run_job\.sh|non_regression_runner\.sh)$'
[ -n "${SKIP_NR:-}" ] && exit 0
DOCS='^(livrables/lecons|sources/veille)/.*\.docx$'
# (4) LES CONSIGNATIONS (27/10/2026). CLAUDE.md et JOBS.md ne correspondaient à AUCUNE
# catégorie : un push qui ne touche qu'elles ne déclenchait rien du tout — mesuré. Un
# contrôle d'orthographe placé dans le seul harnais n'aurait donc jamais tourné sur elles.
# Mode dédié parce qu'il coûte 0,7 s là où le mode normal coûte 160 s, et qu'un ordre se
# termine presque toujours par un push de consignations.
# 🆕 27/10/2026 — LE SKILL `lancer-job` ENTRE DANS CETTE CATÉGORIE. Il nomme chaque job à
#    TROIS endroits (ligne de correspondance, ligne d'aide, `description:` du frontmatter)
#    et n'appartenait à AUCUNE catégorie : un push qui ne touchait que lui ne déclenchait
#    rien. `jobs_config.json`, l'autre moitié de l'invariant, est déjà dans SURVEILLES.
CONSIGNES='^(CLAUDE\.md|outils/scripts/JOBS\.md|\.claude/skills/lancer-job/SKILL\.md)$'
# (5) LE DÉSARMEMENT DE L'ENVIRONNEMENT GIT (27/10/2026). Les trois fichiers qui appellent `git`
# sous un hook doivent porter le `unset` des huit variables AVANT leur premier appel. Deux d'entre
# eux (ce hook, non_regression.sh) sont déjà dans SURVEILLES, donc le harnais complet les couvre ;
# run_job.sh et le runner, eux, ne déclenchent QUE les mutations du runner — qui tournent sans
# GIT_DIR et ne peuvent donc rien voir. Mode dédié à 0,1 s, même raison que --consignes.
DESARMEMENT='^outils/scripts/(run_job\.sh|non_regression_runner\.sh|hooks/pre-push)$'
touche=0; complet=0; runner=0; consignes=0; desarm=0; docs=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue     # suppression de branche
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    plage="${base:+$base..}$local_sha"
  else
    plage="$remote_sha..$local_sha"
  fi
  # --diff-filter=AMR — le R est indispensable (23/09/2026). Un renommage sort en "R", pas en "A" ni en "M" :
  # avec AM, les 112 veilles déplacées dans leurs sous-dossiers (commit 53eabe8) sont parties sur le dépôt
  # public SANS passer par le contrôle — 0 document vu là où AMR en voit 53. Et git appelle "R" un fichier
  # renommé ET MODIFIÉ tant que la similarité reste au-dessus de 50 % (mesuré : R084 pour 16 % du contenu
  # changé), donc `git mv doc.docx autre.docx` suivi d'une édition publiait un document non contrôlé ; un
  # `git mv` depuis un dossier non publié (outils/, en_cours/) vers livrables/ ou sources/veille/ aussi.
  # --name-only rend le chemin de DESTINATION d'un renommage, c'est-à-dire le fichier qui existe après le
  # push : c'est bien celui qu'il faut contrôler. Limite assumée : un contrôle commun renommé VERS un autre
  # nom ne déclenche plus SURVEILLES (son nouveau nom ne correspond plus au motif) — mais non_regression.sh
  # ne le trouverait pas davantage. Les copies (C) ne sont pas détectées par git sans -C, les changements
  # de type (T, un .docx remplacé par un lien symbolique) ne sont pas couverts : aucun incident à ce jour.
  fichiers=$(git diff --name-only --diff-filter=AMR "$plage" 2>/dev/null)
  echo "$fichiers" | grep -Eq "$SURVEILLES" && touche=1
  echo "$fichiers" | grep -Eq "$ASPIRATION" && complet=1
  echo "$fichiers" | grep -Eq "$CINQBIS" && complet=1
  echo "$fichiers" | grep -Eq "$EDPREC" && complet=1
  echo "$fichiers" | grep -Eq "$RUNNER_RE" && runner=1
  echo "$fichiers" | grep -Eq "$CONSIGNES" && consignes=1
  echo "$fichiers" | grep -Eq "$DESARMEMENT" && desarm=1
  for d in $(echo "$fichiers" | grep -E "$DOCS"); do [ -f "$ROOT/$d" ] && docs+=("$ROOT/$d"); done
done
if [ "$touche" = "1" ]; then
  mode=()
  if [ "$complet" = "1" ]; then
    mode=(--complet)
    echo "pre-push : un contrôle à aspiration ou une étape 5 bis est dans ce push → non_regression.sh --complet (≈ 90 s + 4-5 min d'aspiration + les deux étapes 5 bis)…"
  else
    echo "pre-push : un contrôle commun est dans ce push → non_regression.sh (≈ 90 s)…"
  fi
  if "$ROOT/outils/scripts/non_regression.sh" "${mode[@]}"; then
    echo "pre-push : ✓ aucun verdict n'a changé — push autorisé"
  else
    cat <<'MSG'
pre-push : ✗ PUSH REFUSÉ — un verdict a changé, un témoin ne sort plus en 1, ou (mode --complet) un témoin
  à citations ne sort plus en 0.
  Lis le diff ci-dessus. Si chaque changement est voulu et compris :
      outils/scripts/non_regression.sh --accepter   puis commite la référence et repousse.
  Pour passer outre en connaissance de cause : git push --no-verify
MSG
    exit 1
  fi
fi
# les consignations seules : le mode normal les couvre déjà (la fonction y est appelée),
# donc on ne lance le mode dédié que si rien d'autre ne l'a fait.
if [ "$touche" != "1" ] && [ "$consignes" = "1" ]; then
  echo "pre-push : les consignations sont dans ce push → non_regression.sh --consignes (0,7 s)…"
  if "$ROOT/outils/scripts/non_regression.sh" --consignes; then
    echo "pre-push : ✓ aucun nom technique mal écrit — push autorisé"
  else
    cat <<'MSG'
pre-push : ✗ PUSH REFUSÉ — une consignation porte un nom technique mal écrit, ou le contrôle
  d'orthographe ne tient plus ses bornes. La ligne fautive est donnée ci-dessus.
  Passer outre : git push --no-verify
MSG
    exit 1
  fi
fi
# le désarmement git : si le harnais complet tourne déjà (touche=1), son bloc « tous les modes »
# l'a vérifié — on ne le rejoue pas. Sinon, 0,1 s pour la seule chose qu'aucun témoin ne peut
# exercer : la ligne qui empêche un `git` du dépôt de viser le vrai dépôt depuis un hook.
if [ "$touche" != "1" ] && [ "$desarm" = "1" ]; then
  echo "pre-push : un script qui appelle git sous un hook est dans ce push → non_regression.sh --desarmement (0,1 s)…"
  if "$ROOT/outils/scripts/non_regression.sh" --desarmement; then
    echo "pre-push : ✓ les trois désarment avant leur premier git — push autorisé"
  else
    cat <<'MSG'
pre-push : ✗ PUSH REFUSÉ — un script qui appelle git sous un hook ne désarme plus
  l'environnement, ou le fait APRÈS son premier appel à git. Le 27/10, ce défaut a fait
  résoudre le dépôt jetable du runner vers LE VRAI DÉPÔT, passé en core.bare=true pendant
  un push. Le détail est ci-dessus.  Passer outre : git push --no-verify
MSG
    exit 1
  fi
fi
# le runner : sept scénarios de décision sur une copie instrumentée, dépôt jetable, aucun réseau.
# Non couvert par non_regression.sh en mode --docs, donc ce déclencheur est le seul qui le voie
# au moment d'un push qui ne touche que run_job.sh.
if [ "$runner" = "1" ]; then
  echo "pre-push : le runner est dans ce push → non_regression_runner.sh --mutations (18 auto-tests du juge, 14 scénarios, 18 mutations du runner et du juge, ≈ 75 s)…"
  if "$ROOT/outils/scripts/non_regression_runner.sh" --mutations; then
    echo "pre-push : ✓ témoins du runner inchangés — push autorisé"
  else
    cat <<'MSG'
pre-push : ✗ PUSH REFUSÉ — run_job.sh ne décide plus comme avant : une tentative retentée, un exit 0
  non prouvé, ou une publication autorisée à tort. Lis les scénarios en échec ci-dessus. Si le nouveau
  comportement est voulu, mets à jour les attentes dans outils/scripts/non_regression_runner.sh en
  disant pourquoi. Prouve d'abord que le harnais a des dents :
      RUNNER_SOUS_TEST=<ancienne version> outils/scripts/non_regression_runner.sh
  Passer outre : git push --no-verify
MSG
    exit 1
  fi
fi
# documents (livrables, veilles) : chacun comparé à sa référence — un job qui publie passe par ici,
# quelques secondes par document ; un document qui régresse, ou un nouveau qui bloque, n'est pas publié
if [ ${#docs[@]} -gt 0 ]; then
  echo "pre-push : ${#docs[@]} document(s) dans ce push → non_regression.sh --docs…"
  if "$ROOT/outils/scripts/non_regression.sh" --docs "${docs[@]}"; then
    echo "pre-push : ✓ documents conformes — push autorisé"
  else
    cat <<'MSG'
pre-push : ✗ PUSH REFUSÉ — un document régresse (plus de bloquants que sa référence) ou un document
  nouveau bloque aux passes A/A2/A3/A4, ou un décompte de veille est incohérent. Corrige le document
  (journal des corrections, formulation d'origine conservée) ; si le verdict est faux, c'est le contrôle
  qu'on corrige, puis non_regression.sh --accepter. Passer outre : git push --no-verify
MSG
    exit 1
  fi
fi
exit 0
