# Logs d'exécution des jobs planifiés (launchd)
outils/scripts/logs/

# Dépendances Node des scripts temporaires
en_cours/node_modules/
node_modules/

# Fichiers macOS
.DS_Store
**/.DS_Store

# Fichiers de verrouillage/temporaires Office (créés quand un .docx est ouvert)
~$*
**/~$*

# Fichiers temporaires de génération
en_cours/*.js
en_cours/package-lock.json

# Secret d'authentification headless (jeton longue durée) — JAMAIS commité
outils/scripts/claude_auth.env
outils/scripts/.env

# Configuration locale du vault Obsidian (thèmes, plugins, dispositions,
# chemins propres à cette machine) — les NOTES, elles, restent versionnées
.obsidian/

# Canvas Obsidian (tableaux blancs de travail, à tout niveau du vault)
*.canvas

# Notes quotidiennes Obsidian — notes de travail personnelles, jamais publiées.
# Le plugin les déposait à la racine du vault (donc du dépôt) : il est configuré
# pour écrire dans journal/ via .obsidian/daily-notes.json.
journal/
